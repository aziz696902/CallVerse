---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	triage(triage)
	solver(solver)
	approval(approval)
	reviewer(reviewer)
	respond(respond)
	__end__([<p>__end__</p>]):::last
	__start__ --> triage;
	approval --> reviewer;
	reviewer -.-> respond;
	reviewer -.-> solver;
	solver --> approval;
	triage -.-> respond;
	triage -.-> solver;
	respond --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
